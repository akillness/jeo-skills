{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aside.local/shopping-shorts/qa.schema.json",
  "title": "Shopping Shorts QA",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewer_independent", "claim_coverage", "unverified_claims", "fabricated_experience", "asset_rights_complete", "product_identity_preserved", "product_behavior_supported", "generated_footage_text_free", "reference_expression_copied", "batch_count", "realistic_synthetic_content", "youtube_ai_disclosure", "paid_promotion_toggle", "commercial_disclosure", "virtual_person", "visual_review", "generated_text_review", "caption_overlay", "technical", "verdict", "findings"],
  "properties": {
    "reviewer_independent": {"const": true},
    "claim_coverage": {"const": 1},
    "unverified_claims": {"const": 0},
    "fabricated_experience": {"const": false},
    "asset_rights_complete": {"const": true},
    "product_identity_preserved": {"const": true},
    "product_behavior_supported": {"const": true},
    "generated_footage_text_free": {"const": true},
    "reference_expression_copied": {"const": false},
    "batch_count": {"const": 1},
    "realistic_synthetic_content": {"type": "boolean"},
    "youtube_ai_disclosure": {"enum": ["yes", "no", "not-applicable"]},
    "paid_promotion_toggle": {"enum": ["required", "not-required"]},
    "commercial_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "onscreen", "description", "text"],
      "properties": {
        "required": {"type": "boolean"},
        "onscreen": {"type": "boolean"},
        "description": {"type": "boolean"},
        "text": {"type": "string"}
      }
    },
    "virtual_person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "label_visible_while_present"],
      "properties": {
        "present": {"type": "boolean"},
        "label_visible_while_present": {"type": "boolean"}
      }
    },
    "visual_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_frame", "middle_frame", "end_frame", "full_playback"],
      "properties": {
        "start_frame": {"const": true},
        "middle_frame": {"const": true},
        "end_frame": {"const": true},
        "full_playback": {"const": true}
      }
    },
    "generated_text_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewed_at_kst", "final_media_path", "final_media_sha256", "source_clips", "frame_checks", "full_playback_reviewed"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at_kst": {"type": "string", "format": "date-time"},
        "final_media_path": {"type": "string", "pattern": "^assembly/[A-Za-z0-9._/-]+\\.mp4$"},
        "final_media_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_clips": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "unexpected_generated_typography_found", "unexpected_watermark_found"],
            "properties": {
              "path": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "unexpected_generated_typography_found": {"const": false},
              "unexpected_watermark_found": {"const": false}
            }
          }
        },
        "frame_checks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "path", "sha256", "source_media_sha256", "timestamp_seconds", "unexpected_generated_typography_found", "unexpected_watermark_found"],
            "properties": {
              "position": {"enum": ["start", "middle", "end"]},
              "path": {"type": "string", "pattern": "^validation/frames/[A-Za-z0-9._/-]+\\.(png|jpg|jpeg|webp)$"},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "source_media_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "timestamp_seconds": {"type": "number", "minimum": 0, "maximum": 60},
              "unexpected_generated_typography_found": {"const": false},
              "unexpected_watermark_found": {"const": false}
            }
          }
        },
        "full_playback_reviewed": {"const": true}
      }
    },
    "caption_overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "animation", "max_lines", "font_verified", "safe_area_verified", "burn_in_verified"],
      "properties": {
        "source": {"enum": ["none", "assembly-generated"]},
        "animation": {"enum": ["none", "typewriter"]},
        "max_lines": {"type": "integer", "minimum": 0, "maximum": 2},
        "font_verified": {"type": "boolean"},
        "safe_area_verified": {"const": true},
        "burn_in_verified": {"type": "boolean"}
      }
    },
    "technical": {
      "type": "object",
      "required": ["width", "height", "fps", "duration_seconds", "video_codec", "audio_peak_dbfs", "captions_safe"],
      "properties": {
        "width": {"const": 1080},
        "height": {"const": 1920},
        "fps": {"type": "number", "minimum": 24, "maximum": 60},
        "duration_seconds": {"type": "number", "minimum": 15, "maximum": 60},
        "video_codec": {"type": "string"},
        "audio_peak_dbfs": {"type": ["number", "null"], "maximum": 0},
        "captions_safe": {"const": true}
      }
    },
    "verdict": {"enum": ["PASS", "FIX", "BLOCK"]},
    "findings": {"type": "array", "items": {"type": "object"}}
  }
}
