{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aside.local/shopping-shorts/caption-plan.schema.json",
  "title": "Shopping Shorts Caption Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "style", "cues"],
  "properties": {
    "schema_version": {"const": 1},
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["animation", "font_family", "font_size", "primary_color", "outline_color", "outline_width", "max_lines", "max_chars_per_line", "typing_ms_per_character", "minimum_hold_ms", "margin_v"],
      "properties": {
        "animation": {"const": "typewriter"},
        "font_family": {"type": "string", "minLength": 1},
        "font_size": {"type": "integer", "minimum": 32, "maximum": 120},
        "primary_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "outline_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "outline_width": {"type": "number", "minimum": 0, "maximum": 8},
        "max_lines": {"const": 2},
        "max_chars_per_line": {"type": "integer", "minimum": 8, "maximum": 26},
        "typing_ms_per_character": {"type": "integer", "minimum": 25, "maximum": 150},
        "minimum_hold_ms": {"type": "integer", "minimum": 300, "maximum": 5000},
        "margin_v": {"type": "integer", "minimum": 120, "maximum": 520}
      }
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cue_id", "start_seconds", "end_seconds", "text"],
        "properties": {
          "cue_id": {"type": "string", "pattern": "^t[0-9]{2,}$"},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
          "text": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"}
        }
      }
    }
  }
}
