# Root allowlist: everything at the repository root is ignored unless listed below.
# Skills live in .agent-skills/; the other entries are the published install, docs,
# CI and catalog-tooling surface. A new root-level file or directory is never
# committed until it gets its own `!/name` line here.
/*
!/.agent-skills/
!/.frontmatter/
!/.github/
!/.mex/
!/assets/
!/changelog/
!/docs/
!/hooks/
!/jev/
!/scripts/
!/.gitattributes
!/.gitignore
!/AGENTS.md
!/CHANGELOG.md
!/CLAUDE.md
!/README.es-ES.md
!/README.ko.md
!/README.md
!/fix_frontmatter.py
!/flatten_skills.py
!/install.sh
!/setup-all-skills-prompt.md
!/skills-lock.json

# The rules below still apply inside the allowlisted directories.

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# Exception: scripts/lib is source code, not a venv
!scripts/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments and secrets
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Logs
*.log

# IDEs
.vscode/
.idea/

# Agent runtime state inside allowlisted directories
.agent-skills/.omc/
.gjc/

# Skill-specific build artifacts and source clones
.agent-skills/*/bin/
.agent-skills/*/.src/

# Regenerable context layers (managed by `ctx`; rebuilt at checkpoint)
# The curated mex scaffold (.mex/*.md, context/, patterns/, events/) stays tracked.
.graphify/
graphify-out/
.zvec-grep/
.mex/graph.db*
.mex/wiki.db*
.mex/local/
.ouroboros/evidence/
